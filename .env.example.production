APP_NAME="المدوّنة"
APP_ENV=production
APP_KEY=base64:1Iv+zvsvxs0TBP1X8Zz/bJO1+YKW9EJj1/b3BBLFqbM=
APP_DEBUG=false
APP_URL=https://almodawana.dreamhosters.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_MA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ──────────────────────────────────────────────────────
# DATABASE CONFIGURATION - UPDATE WITH YOUR DREAMHOST INFO
# ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=YOUR_DREAMHOST_DB_HOST           # Ask DreamHost support or check panel
DB_PORT=3306
DB_DATABASE=YOUR_DREAMHOST_DB_NAME        # Create database in DreamHost panel
DB_USERNAME=YOUR_DREAMHOST_DB_USER        # Create user in DreamHost panel
DB_PASSWORD=YOUR_DREAMHOST_DB_PASSWORD    # Set password in DreamHost panel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.almodawana.dreamhosters.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@almudawana.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://almodawana.dreamhosters.com/api/v1/auth/google/callback

# ── Sanctum (API Authentication) ──────────────────────
SANCTUM_STATEFUL_DOMAINS=almodawana.dreamhosters.com,almodawana-web.vercel.app
FRONTEND_URL=https://almodawana-web.vercel.app

# ── Meilisearch (Search) ──────────────────────────────
SCOUT_DRIVER=database
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# ── File Storage ──────────────────────────────────────
# Using local storage instead of S3 for DreamHost
FILESYSTEM_DRIVER=local

VITE_APP_NAME="${APP_NAME}"
