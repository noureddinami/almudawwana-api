APP_NAME="المدوّنة"
APP_ENV=production
APP_KEY=base64:1Iv+zvsvxs0TBP1X8Zz/bJO1+YKW9EJj1/b3BBLFqbM=
APP_DEBUG=false
APP_URL=https://almodawana.dreamhosters.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_MA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ===============================================
# DATABASE - FILL WITH YOUR DREAMHOST VALUES
# ===============================================
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_DREAMHOST_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DB_NAME
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ===============================================
SESSION & CACHE
# ===============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.almodawana.dreamhosters.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@almudawana.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ===============================================
# SANCTUM - API Authentication
# ===============================================
SANCTUM_STATEFUL_DOMAINS=almodawana.dreamhosters.com,almodawana-web.vercel.app
FRONTEND_URL=https://almodawana-web.vercel.app

# ===============================================
# SEARCH (Using Database instead of Meilisearch)
# ===============================================
SCOUT_DRIVER=database

# ===============================================
# FILE STORAGE (Local)
# ===============================================
FILESYSTEM_DRIVER=local

VITE_APP_NAME="${APP_NAME}"
